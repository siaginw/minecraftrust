{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RustCraft immutable chunk-packet fixture v1",
  "description": "Structural validation only. Normative same-event, canonical-hash, binary-length, mask and ownership checks are in docs/research/chunk-packet-fixture-v1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "eventId", "captureKind", "runtime", "registry", "chunk", "requestedMask", "encoderSelectedMask", "emittedMask", "fullChunk", "skylight", "sections", "biomes", "payload", "bytesWritten", "decodedSectionCount", "consumedByteCount", "javaReference", "provenance", "hashes"],
  "properties": {
    "format": { "const": "rustcraft-chunk-packet-fixture" },
    "schemaVersion": { "const": 1 },
    "eventId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._:-]+$" },
    "captureKind": { "enum": ["SYNTHETIC", "LIVE_FORGE", "REAL_CLEAN_FORGE_ORACLE", "REAL_CLEAN_FORGE_ORACLE_ACCEPTED"] },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["minecraftVersion", "protocolVersion", "forgeVersion", "javaRuntime", "orderedClasspath", "orderedMods", "orderedCoremods", "orderedConfigs"],
      "properties": {
        "minecraftVersion": { "const": "1.12.2" },
        "protocolVersion": { "const": 340 },
        "forgeVersion": { "type": ["string", "null"], "minLength": 1 },
        "javaRuntime": { "type": ["string", "null"], "minLength": 1 },
        "orderedClasspath": { "$ref": "#/$defs/artifactList" },
        "orderedMods": { "$ref": "#/$defs/artifactList" },
        "orderedCoremods": { "$ref": "#/$defs/artifactList" },
        "orderedConfigs": { "$ref": "#/$defs/artifactList" }
      }
    },
    "registry": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "export", "entryCount", "globalPaletteBits"],
      "properties": {
        "kind": { "enum": ["SYNTHETIC", "RUNTIME_EXPORT"] },
        "export": { "$ref": "#/$defs/artifact" },
        "entryCount": { "type": "integer", "minimum": 1, "maximum": 4294967296 },
        "globalPaletteBits": { "type": "integer", "minimum": 1, "maximum": 32 }
      }
    },
    "chunk": {
      "type": "object", "additionalProperties": false,
      "required": ["dimension", "x", "z", "generationId"],
      "properties": {
        "dimension": { "$ref": "#/$defs/i32" },
        "x": { "$ref": "#/$defs/i32" },
        "z": { "$ref": "#/$defs/i32" },
        "generationId": { "$ref": "#/$defs/u64String" }
      }
    },
    "requestedMask": { "$ref": "#/$defs/mask" },
    "encoderSelectedMask": { "$ref": "#/$defs/mask" },
    "emittedMask": { "$ref": "#/$defs/mask" },
    "fullChunk": { "type": "boolean" },
    "skylight": { "type": "boolean" },
    "sections": {
      "type": "array", "minItems": 16, "maxItems": 16,
      "items": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/section" }] }
    },
    "biomes": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/biomes" }] },
    "payload": { "$ref": "#/$defs/binary" },
    "bytesWritten": { "$ref": "#/$defs/byteCount" },
    "decodedSectionCount": { "type": "integer", "minimum": 0, "maximum": 16 },
    "consumedByteCount": { "$ref": "#/$defs/byteCount" },
    "javaReference": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/javaReference" }] },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["sequenceId", "threadId", "captureImplementation", "ownershipProtocol", "ownershipEvidence", "sourceWriter", "encoderBuild", "independentDecoder", "generator"],
      "properties": {
        "sequenceId": { "$ref": "#/$defs/u64String" },
        "threadId": { "$ref": "#/$defs/u64String" },
        "captureImplementation": { "$ref": "#/$defs/artifact" },
        "ownershipProtocol": { "$ref": "#/$defs/artifact" },
        "ownershipEvidence": { "$ref": "#/$defs/artifactList" },
        "sourceWriter": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/writer" }] },
        "encoderBuild": { "$ref": "#/$defs/artifact" },
        "independentDecoder": { "$ref": "#/$defs/artifact" },
        "generator": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/generator" }] }
      }
    },
    "hashes": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "fixtureSha256"],
      "properties": {
        "algorithm": { "const": "SHA-256" },
        "canonicalization": { "const": "rustcraft-fixture-json-v1" },
        "fixtureSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "fullChunk": { "const": true } } },
      "then": { "properties": { "biomes": { "$ref": "#/$defs/biomes" } } },
      "else": { "properties": { "biomes": { "type": "null" } } }
    },
    {
      "if": { "properties": { "skylight": { "const": true } } },
      "then": { "properties": { "sections": { "items": { "if": { "type": "object" }, "then": { "properties": { "skyLight": { "$ref": "#/$defs/light" } } } } } } },
      "else": { "properties": { "sections": { "items": { "if": { "type": "object" }, "then": { "properties": { "skyLight": { "type": "null" } } } } } } }
    },
    {
      "if": { "properties": { "captureKind": { "enum": ["LIVE_FORGE", "REAL_CLEAN_FORGE_ORACLE", "REAL_CLEAN_FORGE_ORACLE_ACCEPTED"] } } },
      "then": {
        "properties": {
          "runtime": { "properties": { "forgeVersion": { "type": "string", "minLength": 1 }, "javaRuntime": { "type": "string", "minLength": 1 }, "orderedClasspath": { "minItems": 1 } } },
          "registry": { "properties": { "kind": { "const": "RUNTIME_EXPORT" } } },
          "javaReference": { "$ref": "#/$defs/javaReference" },
          "sections": { "items": { "if": { "type": "object" }, "then": { "properties": { "sourcePalette": { "$ref": "#/$defs/palette" } } } } },
          "provenance": { "properties": { "sourceWriter": { "$ref": "#/$defs/writer" }, "ownershipEvidence": { "minItems": 1 }, "generator": { "type": "null" } } }
        }
      },
      "else": {
        "properties": {
          "runtime": { "properties": { "forgeVersion": { "type": "null" } } },
          "registry": { "properties": { "kind": { "const": "SYNTHETIC" } } },
          "provenance": { "properties": { "generator": { "$ref": "#/$defs/generator" } } }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "mask": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "i32": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
    "stateId": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "u64String": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$", "description": "Additional semantic upper bound: 18446744073709551615." },
    "byteCount": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$", "description": "Logical relative artifact name; reject empty, dot and dot-dot path components semantically." },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifactList": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "binary": {
      "type": "object", "additionalProperties": false,
      "required": ["encoding", "data", "byteCount", "sha256"],
      "properties": {
        "encoding": { "const": "base64" },
        "data": { "type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" },
        "byteCount": { "$ref": "#/$defs/byteCount" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "light": { "allOf": [{ "$ref": "#/$defs/binary" }, { "properties": { "byteCount": { "const": 2048 } } }] },
    "biomes": { "allOf": [{ "$ref": "#/$defs/binary" }, { "properties": { "byteCount": { "const": 256 } } }] },
    "palette": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "bitsPerEntry", "entries", "packedWords"],
      "properties": {
        "mode": { "enum": ["LOCAL_LINEAR", "LOCAL_HASH", "GLOBAL"] },
        "bitsPerEntry": { "type": "integer", "minimum": 1, "maximum": 32 },
        "entries": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/stateId" } },
        "packedWords": { "type": "array", "minItems": 64, "maxItems": 2048, "items": { "type": "string", "pattern": "^[0-9a-f]{16}$" } }
      },
      "allOf": [{ "if": { "properties": { "mode": { "const": "GLOBAL" } } }, "then": { "properties": { "entries": { "maxItems": 0 } } }, "else": { "properties": { "entries": { "minItems": 1 } } } }]
    },
    "section": {
      "type": "object", "additionalProperties": false,
      "required": ["y", "logicalStates", "nonAirCount", "tickRefCount", "sourcePalette", "blockLight", "skyLight"],
      "properties": {
        "y": { "type": "integer", "minimum": 0, "maximum": 15 },
        "logicalStates": { "type": "array", "minItems": 4096, "maxItems": 4096, "items": { "$ref": "#/$defs/stateId" } },
        "nonAirCount": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "tickRefCount": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "sourcePalette": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/palette" }] },
        "blockLight": { "$ref": "#/$defs/light" },
        "skyLight": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/light" }] }
      }
    },
    "javaReference": {
      "type": "object", "additionalProperties": false,
      "required": ["emittedMask", "payload", "bytesWritten", "decodedSectionCount", "consumedByteCount"],
      "properties": {
        "emittedMask": { "$ref": "#/$defs/mask" },
        "payload": { "$ref": "#/$defs/binary" },
        "bytesWritten": { "$ref": "#/$defs/byteCount" },
        "decodedSectionCount": { "type": "integer", "minimum": 0, "maximum": 16 },
        "consumedByteCount": { "$ref": "#/$defs/byteCount" }
      }
    },
    "writer": {
      "type": "object", "additionalProperties": false,
      "required": ["className", "methodName", "descriptor", "originalClassSha256", "transformedClassSha256", "orderedTransformers"],
      "properties": {
        "className": { "type": "string", "minLength": 1 },
        "methodName": { "type": "string", "minLength": 1 },
        "descriptor": { "type": "string", "minLength": 1 },
        "originalClassSha256": { "$ref": "#/$defs/sha256" },
        "transformedClassSha256": { "$ref": "#/$defs/sha256" },
        "orderedTransformers": { "$ref": "#/$defs/artifactList" }
      }
    },
    "generator": {
      "type": "object", "additionalProperties": false,
      "required": ["implementation", "seed"],
      "properties": {
        "implementation": { "$ref": "#/$defs/artifact" },
        "seed": { "$ref": "#/$defs/u64String" }
      }
    }
  }
}
